<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup is ignored for device-to-device transfer, so
     exclude all app data from cloud backup and device transfer. The sign-in
     (secure-storage prefs, or the owner-only fallback file) must never reach
     another device (Phase M spec 7.1). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
